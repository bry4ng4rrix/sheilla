# Base SQLite (chemin relatif au dossier prisma/)
DATABASE_URL="file:../data/grh.db"

# Auth.js — générer avec : openssl rand -base64 32
AUTH_SECRET="changez-moi"
# URL publique de l'application (liens de réinitialisation)
APP_URL="http://localhost:3000"
# En production derrière un proxy HTTPS
AUTH_TRUST_HOST=true

# Dossier de stockage des fichiers téléversés (hors de public/)
STORAGE_DIR="./storage"
UPLOAD_MAX_MB=5

# Seed de démonstration (jamais en production)
SEED_ADMIN_EMAIL="admin@jirama.mg"
SEED_ADMIN_PASSWORD=""
SEED_DEMO_PASSWORD=""

# ── Hébergement Vercel (laisser vide en local) ──
# Base SQLite hébergée Turso (libSQL) : remplace DATABASE_URL quand elle est définie
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""
# Vercel Blob (store privé) : remplace STORAGE_DIR quand il est défini
BLOB_READ_WRITE_TOKEN=""
